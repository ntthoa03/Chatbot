GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# H2-11: chỉ đổi một dòng này để dùng implementation thật hoặc fake in-memory.
AI_CORE_INTERFACE_BACKEND=real

# Tenant hiển thị trên Streamlit UI.
AI_CORE_UI_TENANT_ID=mima_internal
AI_CORE_UI_CONFIG_VERSION=1
# Để trống khi chạy nội bộ; không commit mã truy cập thật.
AI_CORE_UI_ACCESS_CODE=
# Hộp chuyển Sale luôn lưu local; webhook là tùy chọn để gửi sang CRM/Slack/Zalo gateway.
AI_UI_HANDOFF_PATH=outputs/handoff_requests.jsonl
AI_UI_HANDOFF_WEBHOOK_URL=

# HOA-15: để trống URL thì backend=auto tiếp tục dùng index local.
# Khi H-06 sẵn sàng, điền endpoint query và API key rồi đặt backend=remote.
AI_CORE_VECTOR_STORE_BACKEND=auto
AI_CORE_VECTOR_STORE_URL=
AI_CORE_VECTOR_STORE_API_KEY=
AI_CORE_VECTOR_STORE_TIMEOUT_SECONDS=10

# HOA-12: semantic LLM chỉ chặn thêm sau rule cứng. Bật sau khi chạy normal + trap eval.
AI_CORE_OUTPUT_GUARDRAIL_SEMANTIC_ENABLED=0
# Chỉ gọi khi rule giá/grounding đang chặn và câu khách có dấu hiệu ngân sách khó.
AI_CORE_PRICING_SEMANTIC_ENABLED=1

# H2-08: mặc định tắt để rollout không làm thay đổi bot cũ ngoài ý muốn.
AI_CORE_SEMANTIC_CACHE_ENABLED=0
AI_CORE_SEMANTIC_CACHE_THRESHOLD=0.94
AI_CORE_SEMANTIC_CACHE_TTL_SECONDS=3600
AI_CORE_SEMANTIC_CACHE_PRICE_TTL_SECONDS=300
